{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Balance robot: configure chassis",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "chassis"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Balance robot: build chassis",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "chassis"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "dependsOn": "Balance robot: configure chassis",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Balance robot: configure gimbal",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "gimbal"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Balance robot: build gimbal",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "gimbal"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "dependsOn": "Balance robot: configure gimbal"
    }
  ]
}
