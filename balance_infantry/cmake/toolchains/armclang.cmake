set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR cortex-m4)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARMCLANG_ROOT "$ENV{ARMCLANG_ROOT}" CACHE PATH "ARM Compiler 6 directory containing bin/")
if(NOT ARMCLANG_ROOT)
  message(FATAL_ERROR "Set ARMCLANG_ROOT to your ARM Compiler 6 directory, e.g. D:/Keil5/ARM/ARMCLANG")
endif()
find_program(CMAKE_C_COMPILER armclang PATHS "${ARMCLANG_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET arm-arm-none-eabi)
set(CMAKE_CXX_COMPILER_TARGET arm-arm-none-eabi)
find_program(CMAKE_AR armar PATHS "${ARMCLANG_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
find_program(CMAKE_LINKER armlink PATHS "${ARMCLANG_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
find_program(CHASSIS_ARMASM armasm PATHS "${ARMCLANG_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
find_program(CHASSIS_FROMELF fromelf PATHS "${ARMCLANG_ROOT}/bin" NO_DEFAULT_PATH REQUIRED)
set(cpu_flags "-mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard -fshort-enums -fshort-wchar")
set(CMAKE_C_FLAGS_INIT "${cpu_flags}")
set(CMAKE_CXX_FLAGS_INIT "${cpu_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "--cpu=Cortex-M4.fp.sp")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARMCLANG_ROOT)
