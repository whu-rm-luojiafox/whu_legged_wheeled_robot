{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "arm-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/armclang.cmake",
      "cacheVariables": {
        "CMAKE_MAKE_PROGRAM": "$penv{LOCALAPPDATA}/Microsoft/WinGet/Packages/Ninja-build.Ninja_Microsoft.Winget.Source_8wekyb3d8bbwe/ninja.exe",
        "ARMCLANG_ROOT": "D:/Keil5/ARM/ARMCLANG",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "chassis",
      "displayName": "balance_robot / chassis LQR",
      "inherits": "arm-base",
      "binaryDir": "${sourceDir}/build/chassis",
      "cacheVariables": {
        "ROBOT_BOARD": "chassis"
      }
    },
    {
      "name": "gimbal",
      "displayName": "balance_robot / gimbal",
      "inherits": "arm-base",
      "binaryDir": "${sourceDir}/build/gimbal",
      "cacheVariables": {
        "ROBOT_BOARD": "gimbal"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "chassis",
      "configurePreset": "chassis",
      "jobs": 2
    },
    {
      "name": "gimbal",
      "configurePreset": "gimbal",
      "jobs": 2
    }
  ]
}
